PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Wrong passwords allowed in a row before the account's login is locked...
LOGIN_MAX_ATTEMPTS=3
# ...and for how long it stays locked.
LOGIN_LOCK_MINUTES=15

# Sessions expire after this many minutes without use (each authenticated action renews it)...
SESSION_IDLE_MINUTES=120
# ...and always after this many days, even if used continuously.
SESSION_MAX_DAYS=7
