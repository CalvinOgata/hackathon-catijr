PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Data (store.json) and uploaded photos are kept here, on this machine's disk
DATA_DIR=data

# Limits for creating auctions (RF05/RF06). For a quick demo, e.g. open in 1 minute and last 3:
LISTING_MIN_LEAD_MINUTES=1
LISTING_MAX_LEAD_DAYS=30
LISTING_MIN_DURATION_MINUTES=3
LISTING_MAX_DURATION_DAYS=7
LISTING_MIN_PHOTOS=3
LISTING_MAX_PHOTOS=8
LISTING_MAX_PHOTO_MB=5

# Anti-sniping (RF15): a bid leaving less than this many minutes moves the end to that long after
# the bid, up to this many minutes past the original end in all
BID_EXTENSION_WINDOW_MINUTES=2
BID_EXTENSION_MAX_MINUTES=30

# Wrong passwords allowed in a row before the account's login is locked...
LOGIN_MAX_ATTEMPTS=3
# ...and for how long it stays locked.
LOGIN_LOCK_MINUTES=15

# Sessions expire after this many minutes without use (each authenticated action renews it)...
SESSION_IDLE_MINUTES=120
# ...and always after this many days, even if used continuously.
SESSION_MAX_DAYS=7
